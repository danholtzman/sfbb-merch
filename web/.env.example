# Copy to a private .env.local for local development. Never commit real secrets.
NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATA_DIR=/absolute/path/to/private/sfbb-data
DATABASE_URL=file:/absolute/path/to/private/sfbb-data/sfbb.sqlite
# Generate per-account hashes with scripts/hash-password.mjs; these placeholders deliberately fail validation.
MEMBER_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
SESSION_TTL_SECONDS=43200

# Optional: separate random secret shared with the trusted Caddy header setup.
# When unset, forwarding headers are ignored and login attempts share a conservative address bucket.
TRUSTED_PROXY_SECRET=

# Optional order confirmations. Disabled unless all three values are configured.
# Verify your sender domain in Resend first; see docs/ORDER-CONFIRMATION-EMAILS.md.
ORDER_CONFIRMATION_EMAILS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
