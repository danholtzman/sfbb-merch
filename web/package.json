{
  "name": "sfbb-merch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "PRISMA_HIDE_UPDATE_MESSAGE=1 DATABASE_URL=file:/tmp/sfbb-generation-unused.sqlite prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "prebuild": "npm run db:generate",
    "pretypecheck": "npm run db:generate && next typegen",
    "pretest": "npm run db:generate",
    "predev": "npm run db:generate",
    "pretest:e2e": "npm run db:generate",
    "db:cleanup": "node scripts/cleanup-assets.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "13.0.3",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "mysql2": "3.24.6"
  },
  "packageManager": "npm@11.19.0"
}
