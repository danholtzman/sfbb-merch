# Install as /srv/sfbb-merch/.env, readable only by the operator (chmod 600).
# Compose fixes DATA_DIR, DATABASE_URL, PUBLIC_ORIGIN and NODE_ENV separately.
# Generate two hashes using web/scripts/hash-password.mjs. No default passwords.
MEMBER_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
SESSION_TTL_SECONDS=43200
# Leave empty until the existing Caddy/tunnel ingress has been validated.
TRUSTED_PROXY_SECRET=

# Optional order confirmations; verify the sender domain in Resend first.
# See docs/ORDER-CONFIRMATION-EMAILS.md. Leave disabled to use checkout without email.
ORDER_CONFIRMATION_EMAILS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
